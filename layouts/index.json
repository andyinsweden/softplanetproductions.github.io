{{- $index := slice -}}
{{- range .Site.Pages -}}
  {{- $section := .Site.GetPage "section" .Section -}}
  {{- $showDate := .Site.Params.article.showDate -}}
  {{- if isset .Params "showdate" -}}
    {{- $showDate = .Params.showDate -}}
  {{- end -}}
  {{- $index = $index | append (dict
    "date" (cond (and .IsPage $showDate (not .Date.IsZero)) (partial "functions/date.html" .Date) nil)
    "title" (.Title | emojify | safeJS)
    "section" ($section.Title | emojify | safeJS)
    "summary" (.Summary | emojify | safeJS)
    "content" (.Plain | emojify | safeJS)
    "permalink" .Permalink
    )
  -}}
{{- end -}}
{{- $index | jsonify -}}
